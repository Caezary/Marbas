<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Description>An orthodox two-panel console file manager.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="FileSystem\EntryName.fs" />
        <Compile Include="FileSystem\FileSystemPath.fs" />
        <Compile Include="FileSystem\ContentError.fs" />
        <Compile Include="FileSystem\TextEncoding.fs" />
        <Compile Include="FileSystem\SortOrder.fs" />
        <Compile Include="FileSystem\HiddenEntries.fs" />
        <Compile Include="FileSystem\Executability.fs" />
        <Compile Include="FileSystem\SearchText.fs" />
        <Compile Include="FileSystem\EditorSettings.fs" />
        <Compile Include="FileSystem\Settings.fs" />
        <Compile Include="FileSystem\DirectoryListing.fs" />
        <Compile Include="FileSystem\Roots.fs" />
        <Compile Include="FileSystem\NamePattern.fs" />
        <Compile Include="FileSystem\Operations.fs" />
        <Compile Include="FileSystem\EntryProperties.fs" />
        <Compile Include="FileSystem\Trash.fs" />
        <Compile Include="FileSystem\FileWindow.fs" />
        <Compile Include="FileSystem\LineIndex.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="State\AppState.fs" />
        <Compile Include="State\Update.fs" />
        <Compile Include="State\Runtime.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Theme\ClassicScheme.fs" />
        <Compile Include="Ui\Theme\DialogStyle.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Format\LiteralText.fs" />
        <Compile Include="Ui\Format\EntrySize.fs" />
        <Compile Include="Ui\Format\EntryFormat.fs" />
        <Compile Include="Ui\Format\TimestampText.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Keys\Modifiers.fs" />
        <Compile Include="Ui\Keys\KeyMap.fs" />
        <Compile Include="Ui\Keys\KeyBarLayout.fs" />
        <Compile Include="Ui\Keys\FunctionKeyBar.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Messages\ListingErrorMessage.fs" />
        <Compile Include="Ui\Messages\ContentErrorMessage.fs" />
        <Compile Include="Ui\Messages\OperationErrorMessage.fs" />
        <Compile Include="Ui\Messages\DeleteConfirmation.fs" />
        <Compile Include="Ui\Messages\OverwriteQuestion.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Panels\EntryColor.fs" />
        <Compile Include="Ui\Panels\PageJump.fs" />
        <Compile Include="Ui\Panels\SelectionSummary.fs" />
        <Compile Include="Ui\Panels\PanelFooter.fs" />
        <Compile Include="Ui\Panels\PanelTitle.fs" />
        <Compile Include="Ui\Panels\FilePanel.fs" />
        <Compile Include="Ui\Panels\PanelWiring.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Viewer\HexDump.fs" />
        <Compile Include="Ui\Viewer\ViewerMode.fs" />
        <Compile Include="Ui\Viewer\PrintableText.fs" />
        <Compile Include="Ui\Viewer\LineWrap.fs" />
        <Compile Include="Ui\Viewer\ViewerScroll.fs" />
        <Compile Include="Ui\Viewer\ViewerHeader.fs" />
        <Compile Include="Ui\Viewer\ViewerKeys.fs" />
        <Compile Include="Ui\Viewer\FileViewer.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\Dialogs\PromptDialog.fs" />
        <Compile Include="Ui\Dialogs\PatternDialog.fs" />
        <Compile Include="Ui\Dialogs\ProgressDialog.fs" />
        <Compile Include="Ui\Dialogs\AssociationRow.fs" />
        <Compile Include="Ui\Dialogs\PropertiesDialog.fs" />
        <Compile Include="Ui\Dialogs\SettingsDialog.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Ui\App\CursorInfo.fs" />
        <Compile Include="Ui\App\StatusLine.fs" />
        <Compile Include="Ui\App\AppView.fs" />
        <Compile Include="Ui\App\Shell.fs" />
        <Compile Include="Ui\App\EditorCommand.fs" />
        <Compile Include="Ui\App\MainWindow.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FsToolkit.ErrorHandling" />
      <PackageReference Include="System.IO.Abstractions" />
      <PackageReference Include="Terminal.Gui" />
    </ItemGroup>

</Project>
