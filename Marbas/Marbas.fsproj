<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="FileSystem\FileSystemPath.fs" />
        <Compile Include="FileSystem\DirectoryListing.fs" />
        <Compile Include="FileSystem\Drives.fs" />
        <Compile Include="FileSystem\NamePattern.fs" />
        <Compile Include="FileSystem\Operations.fs" />
        <Compile Include="State\AppState.fs" />
        <Compile Include="State\Update.fs" />
        <Compile Include="State\Store.fs" />
        <Compile Include="Ui\EntrySize.fs" />
        <Compile Include="Ui\EntryFormat.fs" />
        <Compile Include="Ui\SelectionSummary.fs" />
        <Compile Include="Ui\CursorInfo.fs" />
        <Compile Include="Ui\StatusLine.fs" />
        <Compile Include="Ui\ListingErrorMessage.fs" />
        <Compile Include="Ui\OperationErrorMessage.fs" />
        <Compile Include="Ui\FilePanel.fs" />
        <Compile Include="Ui\FunctionKeyBar.fs" />
        <Compile Include="Ui\PanelInput.fs" />
        <Compile Include="Ui\Shell.fs" />
        <Compile Include="Ui\PromptDialog.fs" />
        <Compile Include="Ui\PatternDialog.fs" />
        <Compile Include="Ui\MainWindow.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
      <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
      <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    </ItemGroup>

</Project>
