<Project>

  <PropertyGroup>
    <MarbasRoot>C:\projects\Marbas</MarbasRoot>
    <DirectoryPackagesPropsPath>$(MarbasRoot)\Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Terminal.Gui" />
    <ProjectReference Include="$(MarbasRoot)\Marbas\Marbas.fsproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
